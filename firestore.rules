rules_version = '2';
// Erika Air access codes.
// Replace YOUR_ADMIN_EMAIL below with the Google account you will sign in with on the admin page.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "YOUR_ADMIN_EMAIL"
        && request.auth.token.email_verified == true;
    }

    // One document per code. The document id is the SHA-256 of the code, so a player
    // can only look up a code they already know, and nobody but the admin can list codes.
    match /codes/{codeId} {
      allow list, create, delete: if isAdmin();
      allow get: if request.auth != null;
      allow update: if isAdmin() || (
        // a player may claim an unused, active code for themselves, once
        request.auth != null
        && resource.data.claimedBy == null
        && resource.data.revoked != true
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
      ) || (
        // the code's owner logs a flight: last-seen time and a flight count, nothing else
        request.auth != null
        && resource.data.claimedBy == request.auth.uid
        && resource.data.revoked != true
        && request.resource.data.lastSeen == request.time
        && request.resource.data.plays == resource.data.get('plays', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'plays'])
      ) || (
        // the code's owner records which aircraft they flew: only the 'fleet' map changes, and it stays small
        request.auth != null
        && resource.data.claimedBy == request.auth.uid
        && resource.data.revoked != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fleet'])
        && request.resource.data.fleet is map
        && request.resource.data.fleet.size() <= 300
      );
    }

    // Code-sharing alerts: a player may only report a real code that is already claimed by someone else.
    // Only the admin can read, mark as seen, or delete them.
    match /alerts/{alertId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'by', 'at', 'seen'])
        && request.resource.data.code is string
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.seen == false
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.claimedBy != null
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.claimedBy != request.auth.uid;
    }
  }
}
